FUNCTION "FC_003_Alarms" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      StatusInverter_7A : "Status";
      StatusCamera_7A : "Status";
      StatusStamping_7A : "Status";
      StatusInverter_7B : "Status";
      StatusCamera_7B : "Status";
      StatusStamping_7B : "Status";
      StatusInverter_10A : "Status";
      StatusCamera_10A : "Status";
      StatusStamping_10A : "Status";
      Diagnostic_7 : "DiagnosticMainCabinet";
      Diagnostic_10 : "DiagnosticMainCabinet";
   END_VAR

   VAR_IN_OUT 
      Alarms_7A : "Alarms_10";
      Alarms_7B : "Alarms_10";
