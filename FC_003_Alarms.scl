	REGION Alarms Convoyer 7
	    #Alarms_7A.ESTOP.Main :=NOT "7_ESTOP";
	    #Alarms_7A.Fault24V := NOT "7_24V_OK";
	    REGION Convoyer 7A   
	        #Alarms_7A.ResetReq := "DEV_7".Convoyer.Modular_A.Safety.REQ_RESET OR NOT "7A_Valve_Safety_1";
	        
	        REGION ESTOP&DOOR
	            #Alarms_7A.ESTOP.Left := NOT "7A_ESTOP_1";
	            #Alarms_7A.ESTOP.Right := NOT "7A_ESTOP_2";
	            #Alarms_7A.Door.Front := NOT "7A_DOOR_1" AND NOT "DEV_7".Convoyer.Modular_A.HMI.DoorDisable.FrontDoor;
	            #Alarms_7A.Door.Back := NOT "7A_DOOR_2" AND NOT "DEV_7".Convoyer.Modular_A.HMI.DoorDisable.BackDoor;
	            #Alarms_7A.Door.Unload := NOT "7A_DOOR_3" AND NOT "DEV_7".Convoyer.Modular_A.HMI.DoorDisable.UnloadDoor;
	        END_REGION
	        REGION Light curtain
	            #Alarms_7A.LightCurtain.Front := (("DEV_7".Convoyer.Modular_A.Pneumatics.Stamping.Coils.In OR "DEV_7".Convoyer.Modular_A.Pneumatics.Stamping.Coils.Out) AND NOT "7A_LIGHT_CURTAIN_1") OR (NOT "DEV_7".Convoyer.Modular_A.Safety.SafetyOK AND NOT "7A_LIGHT_CURTAIN_1");
	        END_REGION
	        
	        REGION INVERTER
	            IF NOT "DEV_7".Convoyer.Modular_A.Safety.REQ_RESET AND "DEV_7".Convoyer.Modular_A.Safety.SafetyOK THEN
