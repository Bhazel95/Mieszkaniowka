	    REGION Diagnostic 7
	        #Alarms_7A.Diagnostic.ET200SP.Head := #Diagnostic_7.ET_200SP.HeadModule_0.diagDIS.OwnState <> 0;
	        #Alarms_7A.Diagnostic.ET200SP.BusAdapter := #Diagnostic_7.ET_200SP.BusAdapter_1.diagDIS.OwnState <> 0;
