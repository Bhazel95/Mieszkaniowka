	            #Alarms_7B.LightCurtain.Front := (("DEV_7".Convoyer.Modular_B.Pneumatics.Stamping.Coils.In OR "DEV_7".Convoyer.Modular_B.Pneumatics.Stamping.Coils.Out) AND NOT "7B_LIGHT_CURTAIN_1") OR (NOT "DEV_7".Convoyer.Modular_B.Safety.SafetyOK AND NOT "7B_LIGHT_CURTAIN_1");
	        END_REGION
	        
	        REGION INVERTER
	            IF NOT "DEV_7".Convoyer.Modular_B.Safety.REQ_RESET AND "DEV_7".Convoyer.Modular_B.Safety.SafetyOK THEN
	                #Alarms_7B.Inverter.GlobalError := NOT "DEV_7".Convoyer.Modular_B.Safety.InverterOK;
	                #Alarms_7B.Inverter.POWER := #StatusInverter_7B.Error AND #StatusInverter_7B.ErrorStatus = 16#8002;
	                #Alarms_7B.Inverter.HALT := #StatusInverter_7B.Error AND #StatusInverter_7B.ErrorStatus = 16#8001;
