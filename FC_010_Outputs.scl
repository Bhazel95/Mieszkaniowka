FUNCTION "FC_010_Outputs" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	//************************************************************
	//===Author: Mateusz Połojko
	//-----Linkedin: https://pl.linkedin.com/in/mateusz-po%C5%82ojko-52a3541b1
	//-----Github: https://github.com/Bhazel95
	//===Description:
	//-----Hardware output assigment
	//===Customer:
	//-----Apator Powogaz S.A.
	//************************************************************
	
	REGION 7A
	    REGION Button box left
	        "7A_BUTTON_LIGHT_START_1" := "DEV_7".Convoyer.Modular_A.ButtonControl.ButtonBoxLeft.LightStart;
	        "7A_BUTTON_LIGHT_RESET_1" := "DEV_7".Convoyer.Modular_A.ButtonControl.ButtonBoxLeft.LightReset;
	        "7A_BUTTON_LIGHT_STOP_1" := "DEV_7".Convoyer.Modular_A.ButtonControl.ButtonBoxLeft.LightStop;
	        "7A_BUTTON_LIGHT_ESTOP_1" := NOT "7A_ESTOP_1";
	    END_REGION
	    REGION Button box right
	        "7A_BUTTON_LIGHT_START_2" := "DEV_7".Convoyer.Modular_A.ButtonControl.ButtonBoxRight.LightStart;
	        "7A_BUTTON_LIGHT_RESET_2" := "DEV_7".Convoyer.Modular_A.ButtonControl.ButtonBoxRight.LightReset;
	        "7A_BUTTON_LIGHT_STOP_2" := "DEV_7".Convoyer.Modular_A.ButtonControl.ButtonBoxRight.LightStop;
	        "7A_BUTTON_LIGHT_ESTOP_2" := NOT "7A_ESTOP_2";
	    END_REGION
	    REGION Lights    
	        "7A_LIGHTS_BUZZER_1" := "DEV_7".Convoyer.Modular_A.Lights.Blue;
	        "7A_LIGHTS_GREEN_1" := "DEV_7".Convoyer.Modular_A.Lights.Green;
	        "7A_LIGHTS_RED_1" := "DEV_7".Convoyer.Modular_A.Lights.Red;
	        "7A_LIGHTS_ORANGE_1" := "DEV_7".Convoyer.Modular_A.Lights.Orange;
	    END_REGION
	    REGION Pneumatics
	        "7A_VALVE_IN_1" := "DEV_7".Convoyer.Modular_A.Pneumatics.Stamping.Coils.In;
	        "7A_VALVE_OUT_1" := "DEV_7".Convoyer.Modular_A.Pneumatics.Stamping.Coils.Out;
	        
	        "7A_VALVE_IN_2" := "DEV_7".Convoyer.Modular_A.Pneumatics.Valve.Coils.In;
	        "7A_VALVE_OUT_2" := "DEV_7".Convoyer.Modular_A.Pneumatics.Valve.Coils.Out;
	        
	        IF "DEV_7".Convoyer.Modular_A.Safety.SafetyOK AND "DEV_7".Convoyer.Modular_A.Sensors.Span THEN
	            "DEV_7".Convoyer.Modular_A.Pneumatics.IVT.Sensor.Scaled.SetNorm := NORM_X(MIN := 0, VALUE := "DEV_7".Convoyer.Modular_A.Pneumatics.IVT.Sensor.Analog.SetValue, MAX := 7);
	            "7A_IVT_OutputSignal_1" := SCALE_X(MIN := 0, VALUE := "DEV_7".Convoyer.Modular_A.Pneumatics.IVT.Sensor.Scaled.SetNorm, MAX := 32767);
	        ELSE
	            "DEV_7".Convoyer.Modular_A.Pneumatics.IVT.Sensor.Scaled.SetNorm := NORM_X(MIN := 0.0, VALUE := 0.0, MAX := 7);
	            "7A_IVT_OutputSignal_1" := SCALE_X(MIN := 0, VALUE := "DEV_7".Convoyer.Modular_A.Pneumatics.IVT.Sensor.Scaled.SetNorm, MAX := 32767);
	        END_IF;
	    END_REGION
	END_REGION
	REGION 7B
	    REGION Button box left
	        "7B_BUTTON_LIGHT_START_1" := "DEV_7".Convoyer.Modular_B.ButtonControl.ButtonBoxLeft.LightStart;
	        "7B_BUTTON_LIGHT_RESET_1" := "DEV_7".Convoyer.Modular_B.ButtonControl.ButtonBoxLeft.LightReset;
	        "7B_BUTTON_LIGHT_STOP_1" := "DEV_7".Convoyer.Modular_B.ButtonControl.ButtonBoxLeft.LightStop;
	        "7B_BUTTON_LIGHT_ESTOP_1" := NOT "7B_ESTOP_1";
	    END_REGION
	    REGION Button box right
	        "7B_BUTTON_LIGHT_START_2" := "DEV_7".Convoyer.Modular_B.ButtonControl.ButtonBoxRight.LightStart;
	        "7B_BUTTON_LIGHT_RESET_2" := "DEV_7".Convoyer.Modular_B.ButtonControl.ButtonBoxRight.LightReset;
	        "7B_BUTTON_LIGHT_STOP_2" := "DEV_7".Convoyer.Modular_B.ButtonControl.ButtonBoxRight.LightStop;
	        "7B_BUTTON_LIGHT_ESTOP_2" := NOT "7B_ESTOP_2";
	    END_REGION
	    REGION Lights    
	        "7B_LIGHTS_BUZZER_1" := "DEV_7".Convoyer.Modular_B.Lights.Blue;
	        "7B_LIGHTS_GREEN_1" := "DEV_7".Convoyer.Modular_B.Lights.Green;
	        "7B_LIGHTS_RED_1" := "DEV_7".Convoyer.Modular_B.Lights.Red;
	        "7B_LIGHTS_ORANGE_1" := "DEV_7".Convoyer.Modular_B.Lights.Orange;
	    END_REGION
	    REGION Pneumatics
	        "7B_VALVE_IN_1" := "DEV_7".Convoyer.Modular_B.Pneumatics.Stamping.Coils.In;
	        "7B_VALVE_OUT_1" := "DEV_7".Convoyer.Modular_B.Pneumatics.Stamping.Coils.Out;
	        
	        "7B_VALVE_IN_2" := "DEV_7".Convoyer.Modular_B.Pneumatics.Valve.Coils.In;
	        "7B_VALVE_OUT_2" := "DEV_7".Convoyer.Modular_B.Pneumatics.Valve.Coils.Out;
	        
	        IF "DEV_7".Convoyer.Modular_B.Safety.SafetyOK AND "DEV_7".Convoyer.Modular_B.Sensors.Span THEN
	            "DEV_7".Convoyer.Modular_B.Pneumatics.IVT.Sensor.Scaled.SetNorm := NORM_X(MIN := 0, VALUE := "DEV_7".Convoyer.Modular_B.Pneumatics.IVT.Sensor.Analog.SetValue, MAX := 7);
	            "7B_IVT_OutputSignal_1" := SCALE_X(MIN := 0, VALUE := "DEV_7".Convoyer.Modular_B.Pneumatics.IVT.Sensor.Scaled.SetNorm, MAX := 32767);
	        ELSE
	            "DEV_7".Convoyer.Modular_B.Pneumatics.IVT.Sensor.Scaled.SetNorm := NORM_X(MIN := 0.0, VALUE := 0.0, MAX := 7);
	            "7B_IVT_OutputSignal_1" := SCALE_X(MIN := 0, VALUE := "DEV_7".Convoyer.Modular_B.Pneumatics.IVT.Sensor.Scaled.SetNorm, MAX := 32767);
	        END_IF;
	    END_REGION
	END_REGION
	REGION Main Cabinet
	    "7_BUTTON_LIGHT_RESET_6" := "DEV_7".Convoyer.Modular_A.ButtonControl.CabinetBox.LightReset OR "DEV_7".Convoyer.Modular_B.ButtonControl.CabinetBox.LightReset;
	    "7_BUTTON_LIGHT_ESTOP_6" := NOT "7_ESTOP";
	END_REGION
	REGION 24V
	    "7AB_24V_OK" := "7_24V_OK";
	END_REGION
	
	
	
END_FUNCTION

